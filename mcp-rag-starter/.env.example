# Copy to .env and replace the placeholders. .env is git-ignored.

# MySQL root password (the app connects as root)
MYSQL_ROOT_PASSWORD=<inlocuieste cu parola root MySQL>

# Base64-encoded HS256 secret, at least 32 bytes before encoding
# e.g.: openssl rand -base64 48
APP_SECURITY_JWT_SECRET=<inlocuieste cu secretul JWT in Base64>

# Static token for /mcp (clients send 'Authorization: Bearer <token>')
# e.g.: openssl rand -hex 32
MCP_API_TOKEN=<inlocuieste cu tokenul MCP>

# Port of the app, inside the container and on the host
APP_PORT=8082

# Image tag used by docker-compose.prod.yml (a commit, e.g. a8b573b, or latest)
APP_IMAGE_TAG=latest
